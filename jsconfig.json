{
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"],
            "@assets/*": ["./src/assets/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@types/*": ["./src/types/*"],
            "@components/*": ["./src/components/*"],
            "@router/*": ["./src/router/*"],
            "@composables/*": ["./src/composables/*"],
            "@views/*": ["./src/views/*"],
            "@services/*": ["./src/services/*"],
            "@stores/*": ["./src/stores/*"],
            "@utils/*": ["./src/utils/*"],
            "@public/*": ["./public/*"]
        }
    },
    "exclude": ["node_modules", "dist"]
}
